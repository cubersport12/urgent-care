{
  "name": "content-builder-web-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/write-environment.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/write-environment.mjs",
    "build": "ng build --base-href=/urgent-care/content-builder/ --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "update": "ng update @angular/core @angular/cli @angular/cdk @angular/material --force",
    "sync-openapi": "node scripts/sync-openapi.mjs",
    "generate-api": "openapi-ts && node scripts/stamp-generated-api.mjs",
    "sync-and-generate-api": "npm run sync-openapi && npm run generate-api"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/material": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@ngxs/store": "^21.0.0",
    "angular-split": "^20.0.0",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "open": "^10.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@eslint/js": "^9.17.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@stylistic/eslint-plugin": "^2.12.1",
    "@types/jasmine": "~5.1.0",
    "@types/jszip": "^3.4.1",
    "@types/lodash": "^4.17.13",
    "@types/uniqid": "^5.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "less": "^4.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.0.8"
  }
}
