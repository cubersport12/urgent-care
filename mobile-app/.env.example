# API base URL (no trailing slash). Baked in at bundle time for native builds.
#
# Dev (optional — defaults already cover emulator/simulator):
#   Web / iOS simulator: http://localhost:8000
#   Android emulator:    http://10.0.2.2:8000
#   Physical device LAN: http://<your-pc-lan-ip>:8000
#
# Release APK / production (required if not using the built-in default):
#   EXPO_PUBLIC_API_URL=https://trouble-dent.ru
#
# Without this in a release build, the app now defaults to https://trouble-dent.ru
# (__DEV__ still uses emulator/localhost). Do not ship localhost / 10.0.2.2 in release.
EXPO_PUBLIC_API_URL=http://localhost:8000
