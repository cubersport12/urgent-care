# Copy to sites-available after domain + certs are ready, then:
#   ln -sf /etc/nginx/sites-available/urgent-care-ssl /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Replace YOUR_DOMAIN and cert paths as needed.

upstream urgent_care_api {
    server 127.0.0.1:8001;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    include /etc/nginx/snippets/urgent-care-ssl.conf;

    root /var/www/urgent-care;
    index index.html;
    client_max_body_size 50m;

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_pass http://urgent_care_api;
    }

    location = /health {
        proxy_pass http://urgent_care_api/health;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /docs {
        proxy_pass http://urgent_care_api/docs;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /redoc {
        proxy_pass http://urgent_care_api/redoc;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /openapi.json {
        proxy_pass http://urgent_care_api/openapi.json;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /content-builder/ {
        try_files $uri $uri/ /content-builder/index.html;
    }

    location /mobile-app/ {
        try_files $uri $uri/ /mobile-app/index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
