# Copy to .env and fill in real values.

ENVIRONMENT=dev
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://urgent:urgent_pass@localhost:5432/urgent_care
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# openssl rand -hex 32
JWT_SECRET=please_generate_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=60
BCRYPT_ROUNDS=12

# Email of migrated/created user that should get role=admin
ADMIN_EMAIL=test@yandex.ru
# Support chat inbox (user messages). Empty → ADMIN_EMAIL
SUPPORT_EMAIL=

# SMTP (password reset + support chat copy). Leave SMTP_HOST empty → emails logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
PASSWORD_RESET_URL=https://trouble-dent.ru/mobile-app/reset-password

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_MEDIA=cubersport12
S3_REGION=us-east-1

CORS_ORIGINS=["http://localhost:4200","http://localhost:8081","http://localhost:3000"]

# YooKassa
# Leave empty in non-prod → mock activate (no payment UI).
# For test payments: put test shop id + secret key (starts with test_) from YooKassa cabinet,
# restart API, then mobile will open the real payment page.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Deep link for mobile AuthSession (must match app scheme in app.json)
YOOKASSA_RETURN_URL=troubledent://billing/return
BILLING_ENFORCEMENT=true

# Production example (VPS by IP):
# ENVIRONMENT=staging
# DEBUG=false
# API_PUBLIC_BASE_URL=http://77.91.90.39
# DATABASE_URL=postgresql+asyncpg://urgent:urgent_pass@postgres:5432/urgent_care
# S3_ENDPOINT=http://minio:9000
# CORS_ORIGINS=["http://77.91.90.39"]
